{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "inlineSourceMap": true,
    "strict": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/__tests__/**/*", "**/spec.ts"]
}
